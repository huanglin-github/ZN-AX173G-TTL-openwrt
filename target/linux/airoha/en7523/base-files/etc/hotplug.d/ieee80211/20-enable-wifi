#!/bin/sh
# Enable WiFi radios when detected on the EN7523 AX3000 router.
# This runs AFTER 10-wifi-detect (which generates /etc/config/wireless via
# /sbin/wifi config).
[ "$ACTION" = "add" ] || exit 0
. /lib/functions.sh
[ "$(board_name)" = "airoha,en7523-ax3000-router" ] || exit 0
[ -f /tmp/.wifi-enabled ] && exit 0

# Wait for /etc/config/wireless to exist (10-wifi-detect generates it)
i=0
while [ ! -f /etc/config/wireless ] && [ $i -lt 15 ]; do
	sleep 1
	i=$((i + 1))
done
[ -f /etc/config/wireless ] || exit 0

# CN regdomain: without it 2.4G is PASSIVE-SCAN and cannot send beacons
uci -q set wireless.radio0.country='CN'
uci -q set wireless.radio1.country='CN'
uci -q set wireless.default_radio0.disabled=0
uci -q set wireless.default_radio1.disabled=0
uci -q set wireless.default_radio0.ssid='OpenWrt-AX3000'
uci -q set wireless.default_radio1.ssid='OpenWrt-AX3000-5G'
# Open network by default (no password) - user asked for passwordless default
uci -q set wireless.default_radio0.encryption='none'
uci -q delete wireless.default_radio0.key
uci -q set wireless.default_radio1.encryption='none'
uci -q delete wireless.default_radio1.key
uci commit wireless

# Full restart, NOT "wifi reload": reload does not re-initialise phy0,
# which leaves the 2.4G radio without a running BSS.
wifi
touch /tmp/.wifi-enabled
