#!/bin/sh
# Fix LED triggers for kernels where the netdev LED trigger has no 'mode' file
# (newer kernels expose separate link/rx/tx flag files instead). OpenWrt's
# uci/system 'option mode' cannot be written there, so the WiFi/Internet LEDs
# stay off. We set the flags directly on sysfs, after interfaces are up.
setup_led() {
	local led="$1" dev="$2"
	local d="/sys/class/leds/$led"
	[ -d "$d" ] || return 0
	echo netdev > "$d/trigger" 2>/dev/null
	echo "$dev"  > "$d/device_name" 2>/dev/null
	echo 1       > "$d/link" 2>/dev/null
	echo 1       > "$d/rx" 2>/dev/null
}

setup_led green:wifi-2g  phy0-ap0
setup_led green:wifi-5g   phy1-ap0
setup_led green:internet  eth1

exit 0
