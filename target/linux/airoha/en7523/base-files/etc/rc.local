#!/bin/sh
#
# Put anything here that should be executed at boot.
#
# xHCI PORTSC[3] (second USB2 port) is left at PLS=Unknown by our PHY driver;
# the vendor firmware pokes it from userspace (sys memwl 1fab0440 A0). Do the
# same here once per boot. Only works when CONFIG_IO_STRICT_DEVMEM is disabled.
if [ -c /dev/mem ]; then
	# PP=1 (port power) + PLS=5 (RxDetect)
	printf '\240\002\000\000' | dd of=/dev/mem bs=4 seek=132825360 count=1 conv=notrunc 2>/dev/null
	logger -t usb-port3 "PORTSC[3] poked to RxDetect"
fi

exit 0
