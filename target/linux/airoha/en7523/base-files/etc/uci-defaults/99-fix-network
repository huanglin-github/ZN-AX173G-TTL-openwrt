#!/bin/sh
# EN7523 first-boot fixes (no pre-configured bridge/relay)
# - timezone CST-8 / Asia/Shanghai
# - DHCP force (avoid "already running DHCP-server" false positive from STA/AP co-located radio)
# - IPv6 server mode for LAN
# - enable cron
# NOTE: bridging/relay to an upstream AP is NOT pre-configured. Configure it
#       manually when needed (e.g. set LAN to 192.168.2.1, then add a relay
#       interface bridging 'wwan' and 'lan').

# 1) timezone
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'

# 2) DHCP force
uci set dhcp.lan.force='1'

# 3) IPv6 server mode
uci set dhcp.lan.ra='server'
uci set dhcp.lan.dhcpv6='server'
uci set dhcp.lan.ndp='hybrid'

# 4) enable cron
/etc/init.d/cron enable

# 5) default LuCI language: Simplified Chinese
uci set luci.main.lang='zh_cn'
uci commit luci

uci commit network
uci commit dhcp

exit 0
