#!/bin/sh
# Argon 作为默认主题：overlay 保留的 sysupgrade 不会重跑 argon 自带的 30_luci-theme-argon，
# 这里在每次首启/升级后强制把 LuCI 默认主题指回 argon（文件名字典序最后，保证覆盖 luci 默认值）。
uci -q get luci.themes >/dev/null 2>&1 || uci set luci.themes=themes
uci set luci.themes.Argon='/luci-static/argon'
uci set luci.main.mediaurlbase='/luci-static/argon'
uci -q get luci.main.lang >/dev/null 2>&1 || uci set luci.main.lang='zh_cn'
uci commit luci
exit 0
