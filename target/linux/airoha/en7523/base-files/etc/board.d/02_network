. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

en7523_setup_interfaces()
{
	local board="$1"

	case "$board" in
	airoha,en7523-evb)
		ucidef_set_interfaces_lan_wan "eth1 eth2 eth3 eth4" "eth0"
		;;
	airoha,en7523-ax3000-router)
		# DSA port mapping, verified on hardware 2026-10-25:
		#   eth1=p1=LAN1, eth2=p2=LAN2, eth3=p3=LAN3, eth4=p4=LAN4
		# (the previous comment had this reversed - the user's PC was on the
		#  case port labelled LAN4 and showed up as eth4, which pins pN == LANN.)
		# eth0 is the DSA conduit (must NOT be in the bridge).
		# WAN is the first port LAN1 (eth1); LAN2/3/4 are the bridge ports.
		ucidef_set_interfaces_lan_wan "eth2 eth3 eth4" "eth1"
		;;
	*)
		echo "Unsupported hardware. Network interfaces not initialized"
		;;
	esac
}

board_config_update
board=$(board_name)
en7523_setup_interfaces $board
board_config_flush

exit 0
