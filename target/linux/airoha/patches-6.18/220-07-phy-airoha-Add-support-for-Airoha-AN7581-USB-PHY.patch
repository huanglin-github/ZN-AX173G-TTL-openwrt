 drivers/phy/airoha/Kconfig          |  10 +
 drivers/phy/airoha/Makefile         |   1 +
 drivers/phy/airoha/phy-airoha-usb.c | 597 ++++++++++++++++++++++++++++
 4 files changed, 609 insertions(+)
