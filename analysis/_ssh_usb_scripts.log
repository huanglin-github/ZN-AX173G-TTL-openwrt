#!/bin/sh
PROFILE_CFG=/userfs/profile.cfg
if [ -f $PROFILE_CFG ] ; then
    . $PROFILE_CFG
fi

if [ "$TCSUPPORT_USBHOST" != "" ] ;then
echo "TCSUPPORT_USBHOST"
#usb host
insmod /lib/modules/usbhost/scsi_mod.ko
insmod /lib/modules/usbhost/scsi_wait_scan.ko
insmod /lib/modules/usbhost/sd_mod.ko
insmod /lib/modules/usbhost/nls_base.ko
insmod /lib/modules/usbhost/nls_ascii.ko
insmod /lib/modules/usbhost/nls_cp437.ko
if [ "$TCSUPPORT_CT_FTP_DOWNLOADCLIENT" != "" ] ;then
insmod /lib/modules/usbhost/nls_cp936.ko
fi
if [ "$TCSUPPORT_CT_JOYME" != "" ] || [ "$TCSUPPORT_CT_JOYME2" != "" ] ;then
insmod /lib/modules/usbhost/nls_utf8.ko
fi
insmod /lib/modules/usbhost/fat.ko
#insmod /lib/modules/usbhost/msdos.ko
insmod /lib/modules/usbhost/vfat.ko
insmod /lib/modules/usbhost/usbcore.ko
if [ "$TCSUPPORT_MUH" != "" ] ;then
insmod /lib/modules/usbhost/xhci-hcd.ko
else
insmod /lib/modules/usbhost/ehci-hcd.ko
insmod /lib/modules/usbhost/ohci-hcd.ko
fi
insmod /lib/modules/usbhost/usb-storage.ko
if [ "$TCSUPPORT_USB_NTFS" != "" ] ;then
insmod lib/modules/usbhost/fuse.ko
fi
if [ "$TCSUPPORT_USB_3G_DONGLE" != "" ] ;then
insmod lib/modules/usbhost/usbserial.ko
insmod lib/modules/usbhost/option.ko

insmod $KERNEL_DIR/kernel/lib/crc-ccitt.ko
insmod lib/modules/ppp_async.ko
fi
if [ "$TCSUPPORT_USB_CAMERA" != "" ] ;then
insmod lib/modules/usbhost/v4l1-compat.ko
insmod lib/modules/usbhost/videodev.ko
insmod lib/modules/usbhost/usbvideo.ko
insmod lib/modules/usbhost/uvcvideo.ko
fi
if [ "$TCSUPPORT_USB_PRINTER_SERVER" != "" ] ;then
insmod lib/modules/usbhost/usblp.ko
fi	
fi

#AutoMount
if [ "$TCSUPPORT_USB_AUTOMOUNT" != "" ] ;then
/userfs/bin/usb_auto_mount &
fi



==================== /home/huanglin/rootfs_x/usr/script/usb_insmod.sh ====================
#!/bin/sh
PROFILE_CFG=/userfs/profile.cfg
if [ -f $PROFILE_CFG ] ; then
    . $PROFILE_CFG
fi
if [ -d "/proc/bus/usb" ] ;then
	echo "USB already insert"
else
if [ "$TCSUPPORT_USBHOST" != "" ] && [ -f "/proc/tc3162/sys_has_usbhost" ] ;then
echo "TCSUPPORT_USBHOST"
#usb host
insmod /lib/modules/usbhost/scsi_mod.ko
insmod /lib/modules/usbhost/scsi_wait_scan.ko
insmod /lib/modules/usbhost/sd_mod.ko
insmod /lib/modules/usbhost/nls_base.ko
if [ "$TCSUPPORT_SAMBA" != "" ] || [ "$TCSUPPORT_SAMBA_IPv6" != "" ] || [ "$TCSUPPORT_SAMBA_4" != "" ];then
if [ -f "/lib/modules/usbhost/nls_utf8.ko" ] ;then
insmod /lib/modules/usbhost/nls_utf8.ko
fi
insmod /lib/modules/usbhost/nls_cp936.ko
else
insmod /lib/modules/usbhost/nls_ascii.ko
insmod /lib/modules/usbhost/nls_cp437.ko
fi
insmod /lib/modules/usbhost/fat.ko
insmod /lib/modules/usbhost/vfat.ko
insmod /lib/modules/usbhost/usbcore.ko
if [ "$TCSUPPORT_MUH" != "" ] ;then
if [ "$TCSUPPORT_MUH_TEST" != "" ] ;then
insmod /lib/modules/usbhost/xhci-test.ko
else
insmod /lib/modules/usbhost/xhci-hcd.ko
fi
else
insmod /lib/modules/usbhost/ehci-hcd.ko
insmod /lib/modules/usbhost/ohci-hcd.ko
fi
insmod /lib/modules/usbhost/usb-storage.ko
if [ "$TCSUPPORT_USB_NTFS" != "" ] ;then
insmod lib/modules/usbhost/fuse.ko
fi
if [ "$TCSUPPORT_USB_3G_DONGLE" != "" ] ;then
insmod lib/modules/usbhost/usbserial.ko
insmod lib/modules/usbhost/option.ko
insmod $KERNEL_DIR/kernel/lib/crc-ccitt.ko
insmod lib/modules/ppp_async.ko
fi
if [ "$TCSUPPORT_USB_CAMERA" != "" ] ;then
insmod lib/modules/usbhost/v4l1-compat.ko
insmod lib/modules/usbhost/videodev.ko
insmod lib/modules/usbhost/usbvideo.ko
insmod lib/modules/usbhost/uvcvideo.ko
fi
if [ "$TCSUPPORT_USB_PRINTER_SERVER" != "" ] ;then
insmod lib/modules/usbhost/usblp.ko
fi	
fi

MOUNTPID=`pidof usb_auto_mount`
if [ "$MOUNTPID" = "" ] ;then
if [ "$TCSUPPORT_USB_AUTOMOUNT" != "" ] ;then
/userfs/bin/usb_auto_mount &
fi
fi

if [ "$TCSUPPORT_USBDEVICE20" != "" ] && [ -f "/proc/tc3162/sys_has_usb_device" ];then
echo "TCSUPPORT_USBDEVICE20"
#usb device
insmod /lib/modules/tc3162_udc20.ko
insmod /lib/modules/g_ether.ko

echo "TCSUPPORT_USBDEVICE20: ifconfig usb0 0.0.0.0 up"
ifconfig usb0 0.0.0.0 up

echo "TCSUPPORT_USBDEVICE20: brctl addif br0 usb0"
brctl addif br0 usb0
fi
fi


==================== /home/huanglin/rootfs_x/usr/script/CMCC_p1.sh ====================
#!/bin/sh
PROFILE_CFG=/userfs/profile.cfg
if [ -f $PROFILE_CFG ] ; then
    chmod 777 $PROFILE_CFG
    . $PROFILE_CFG
fi

if [ "$#" -eq "1" ] ; then
      echo "usage: $0 0(USB_GPIO_LOW)"
fi

echo "tml h 30" > /proc/tc3162/tcci_cmd
echo "tml l 20" > /proc/tc3162/tcci_cmd
pwctlcmd lowpwr 1

/usr/bin/sys memwl 1FA201E4 0xfb3bbfe7
/usr/bin/sys memwl 1FA201E8 0xf7c1fff5

sys wlanled on
/userfs/bin/tcapi set WLan_Common power_consumption_wifi Yes
/userfs/bin/tcapi set WLan_Common switch_id 1
/userfs/bin/tcapi commit WLan11ac_Common

/usr/bin/sys memwl 1fa9380c c0000000
/usr/bin/sys memwl 1fa95a00 4b000020
/usr/bin/sys memwl 1fa95a04 25116432

if [ "$1" = "0" ]; then
echo active 4 0 > /proc/tc3162/gpio_output
else
echo active 4 1 > /proc/tc3162/gpio_output
fi	

echo active 5 1 > /proc/tc3162/gpio_output
/usr/bin/sys memwl 1fab0420 A0
/usr/bin/sys memwl 1fab0430 A0
/usr/bin/sys memwl 1fab0440 A0


tce emiiw 9 1f 269 144f
tce emiiw 9 1f 271 7e0e
tce emiiw 9 1f 272 7cff
tce emiiw 9 1e 5c 5555
tce emiiw 10 1e 5c 5555
tce emiiw 11 1e 5c 5555
tce emiiw 12 1e 5c 5555
tce miiw 9 0 1200
tce miiw 10 0 1200
tce miiw 11 0 1200
tce miiw 12 0 1200

sifm xw 0 0xc7 0x70 2 0x00 4 00 00 50 4a

echo 1 > /proc/slic/slic_api_patch
echo "0 0 14000" > /proc/fxs/slicControl

/userfs/bin/tcapi set WLan_Common power_consumption_wifi No
/userfs/bin/tcapi set WLan_Entry1 EnableSSID 0

killall -9 jvm_monitor
killall -9 java
killall -9 trafficmirror
killall -9 bundle_monitor


